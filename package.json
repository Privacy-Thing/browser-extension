{
  "name": "privacything",
  "version": "0.9.2.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "description": "Advanced anti-fingerprinting and location spoofing browser extension.",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Privacy-Thing/browser-extension"
  },
  "scripts": {
    "changelog:promote": "node scripts/promote-unreleased-changelog.mjs --write",
    "task": "pnpm exec task",
    "dev": "pnpm exec vite --config config/vite.config.ts",
    "dev:chrome": "pnpm exec task dev:chrome",
    "dev:firefox": "pnpm exec task dev:firefox",
    "build": "pnpm exec task build",
    "build:e2e-assets": "pnpm exec task build:e2e-assets",
    "build:chrome": "pnpm exec task build:chrome",
    "build:chrome:watch": "pnpm exec task build:chrome:watch",
    "build:firefox": "pnpm exec task build:firefox",
    "build:firefox:watch": "pnpm exec task build:firefox:watch",
    "generate:icons": "node scripts/generate-icon-assets.mjs",
    "generate:locales": "node scripts/build-locales.mjs",
    "generate:firefox-update-manifest": "node scripts/generate-firefox-update-manifest.mjs",
    "generate:legal": "pnpm exec task generate:legal",
    "generate:legal:third-party-notices": "pnpm exec task generate:legal:third-party-notices",
    "package:source": "node scripts/package-source-code.mjs",
    "package:chrome": "pnpm exec task package:chrome",
    "package:firefox": "pnpm exec task package:firefox",
    "package:release": "pnpm exec task package:release",
    "preview": "pnpm exec task preview",
    "generate:osm-country-languages": "node scripts/build-osm-country-languages.mjs",
    "generate:chrome-versions": "node scripts/build-chrome-versions.mjs",
    "generate:hardware-steam": "node scripts/build-steam-hardware.mjs",
    "generate:hardware-apple": "node scripts/build-apple-hardware.mjs",
    "generate:hardware": "pnpm generate:hardware-steam && pnpm generate:hardware-apple",
    "lint": "pnpm exec task lint",
    "format": "pnpm exec task format",
    "format:check": "pnpm exec task format:check",
    "verify": "pnpm exec task verify",
    "verify:quick": "pnpm exec task verify:quick",
    "test": "pnpm exec task test",
    "test:unit": "pnpm exec task test:unit",
    "test:unit:app": "pnpm exec task test:unit:app",
    "test:unit:tooling": "pnpm exec task test:unit:tooling",
    "test:unit:coverage": "pnpm exec task test:unit:coverage",
    "test:unit:coverage:app": "pnpm exec task test:unit:coverage:app",
    "test:unit:coverage:chrome": "pnpm exec task test:unit:coverage:chrome",
    "test:unit:coverage:firefox": "pnpm exec task test:unit:coverage:firefox",
    "test:unit:changed": "pnpm exec task test:unit:changed",
    "test:unit:watch": "pnpm exec task test:unit:watch",
    "test:e2e": "pnpm exec task test:e2e",
    "test:e2e:ci": "pnpm exec task test:e2e:ci",
    "test:e2e:product": "pnpm exec task test:e2e:product",
    "test:e2e:release": "pnpm exec task test:e2e:release",
    "test:e2e:publish": "pnpm exec task test:e2e:publish",
    "test:e2e:firefox-runtime": "pnpm exec task test:e2e:firefox-runtime",
    "test:e2e:browserleaks": "pnpm exec task test:e2e:browserleaks",
    "test:build-contracts": "pnpm exec task test:build-contracts",
    "check": "pnpm exec task check",
    "check:tools": "pnpm exec task check:tools",
    "check:test-lanes": "pnpm exec task check:test-lanes",
    "check:test-targets": "pnpm exec task check:test-targets",
    "check:test-determinism": "pnpm exec task check:test-determinism",
    "validate:metadata": "tsx scripts/validate-generated-metadata.ts",
    "start:chrome": "pnpm exec task start:chrome",
    "start:firefox": "pnpm exec task start:firefox",
    "storybook": "pnpm exec task storybook",
    "storybook:build": "storybook build -o build/storybook-static",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:api-conformance": "pnpm exec task test:api-conformance",
    "benchmark:tests": "node scripts/benchmark-test-suite.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@photostructure/tz-lookup": "^11.6.1",
    "@privacy-thing/brand": "^0.2.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@go-task/cli": "^3.52.0",
    "@mdn/browser-compat-data": "^8.0.11",
    "@playwright/test": "1.58.2",
    "@privacy-brand/refract-browser": "workspace:*",
    "@privacy-brand/refract-core": "workspace:*",
    "@privacy-brand/refract-worker": "workspace:*",
    "@privacy-brand/tooling-shared": "workspace:*",
    "@privacy-brand/xray-protocol": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/chrome": "^0.2.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "locale-codes": "1.3.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "storybook": "^10.5.7",
    "tailwindcss": "3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0"
  }
}
